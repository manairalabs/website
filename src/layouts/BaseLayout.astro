---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  keywords?: string;
}

const defaultKeywords = "AI consulting Indonesia, AI strategy consulting, AI implementation strategy, enterprise AI solutions Indonesia, machine learning consulting Indonesia, AI automation consulting, konsultan AI Indonesia, AI ROI business, custom AI development, Manaira Labs";

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/icons/og-image.png',
  keywords = defaultKeywords
} = Astro.props;

const siteUrl = 'https://manairalabs.com';

// BreadcrumbList for inner pages
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbSchema = pathSegments.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    ...pathSegments.map((segment: string, i: number) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
      "item": `${siteUrl}/${pathSegments.slice(0, i + 1).join('/')}`
    }))
  ]
} : null;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="keywords" content={keywords}>
    <meta name="author" content="Manaira Labs">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href={canonical}>
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonical}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={`${siteUrl}${ogImage}`}>
    <meta property="og:site_name" content="Manaira Labs">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content={canonical}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`}>

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png">
    <link rel="manifest" href="/icons/site.webmanifest">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="/styles/main.css">

    <!-- Page-specific styles -->
    <slot name="head" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Manaira Labs",
      "url": siteUrl,
      "logo": `${siteUrl}/icons/logo.png`,
      "description": "AI consulting and implementation for Indonesian businesses. Custom AI development, strategy, and enterprise solutions.",
      "sameAs": [
        "https://linkedin.com/company/manairalabs",
        "https://twitter.com/manairalabs",
        "https://instagram.com/manairalabs"
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Manaira Labs",
      "url": siteUrl,
      "description": "AI consulting, strategy, and implementation services for businesses in Indonesia",
      "areaServed": {
        "@type": "Country",
        "name": "Indonesia"
      },
      "serviceType": [
        "AI Consulting",
        "AI Strategy",
        "Custom AI Development",
        "Machine Learning Consulting",
        "AI Implementation",
        "Enterprise AI Solutions"
      ],
      "knowsLanguage": ["en", "id"]
    })} />

    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Theme initialization -->
    <script is:inline>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <!-- Cursor Dot -->
    <div class="cursor-dot" id="cursorDot"></div>

    <!-- Robot Cursor -->
    <div class="robot-cursor" id="robotCursor">
        <svg viewBox="0 0 80 90" fill="none" xmlns="http://www.w3.org/2000/svg" class="robot-svg">
            <g class="robot-arm robot-arm-left" id="robotArmLeft">
                <ellipse cx="8" cy="52" rx="6" ry="8" fill="#00f0ff"/>
                <rect x="4" y="44" width="8" height="4" rx="2" fill="#00f0ff" opacity="0.7"/>
            </g>
            <g class="robot-arm robot-arm-right" id="robotArmRight">
                <ellipse cx="72" cy="52" rx="6" ry="8" fill="#00f0ff"/>
                <rect x="68" y="44" width="8" height="4" rx="2" fill="#00f0ff" opacity="0.7"/>
            </g>
            <ellipse cx="40" cy="58" rx="22" ry="18" fill="#00f0ff" opacity="0.3"/>
            <ellipse cx="40" cy="56" rx="18" ry="14" fill="#0a1628" stroke="#00f0ff" stroke-width="2"/>
            <ellipse cx="40" cy="32" rx="26" ry="24" fill="#0a1628" stroke="#00f0ff" stroke-width="2"/>
            <ellipse cx="40" cy="35" rx="20" ry="14" fill="#111" stroke="#00f0ff" stroke-width="1" opacity="0.9"/>
            <path d="M28 32 Q32 28 36 32" stroke="#00f0ff" stroke-width="3" stroke-linecap="round" fill="none" class="robot-eye"/>
            <path d="M44 32 Q48 28 52 32" stroke="#00f0ff" stroke-width="3" stroke-linecap="round" fill="none" class="robot-eye"/>
            <line x1="40" y1="8" x2="40" y2="14" stroke="#00f0ff" stroke-width="2"/>
            <circle cx="40" cy="6" r="4" fill="#00f0ff" class="robot-antenna"/>
            <circle cx="14" cy="30" r="4" fill="#00f0ff" opacity="0.8"/>
            <circle cx="66" cy="30" r="4" fill="#00f0ff" opacity="0.8"/>
        </svg>
    </div>

    <!-- Neural Network Background -->
    <canvas id="neuralCanvas"></canvas>

    <nav class="nav" id="nav">
        <div class="nav-inner">
            <a href="/" class="nav-logo">
                <img src="/icons/logo-text-light.png" alt="Manaira Labs" class="logo-img logo-light">
                <img src="/icons/logo-text-dark.png" alt="Manaira Labs" class="logo-img logo-dark">
            </a>
            <div class="nav-links">
                <div class="nav-dropdown">
                    <button class="nav-link nav-dropdown-trigger">
                        PRODUCTS
