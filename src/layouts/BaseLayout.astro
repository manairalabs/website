                            <path d="M6 9l6 6 6-6"/>
                        </svg>
                    </button>
                    <div class="nav-dropdown-menu">
                        <a href="https://bicara.ai" target="_blank" rel="noopener" class="dropdown-item">
                            <span class="dropdown-item-name">BicaraAI</span>
                            <span class="dropdown-item-desc">Customer Service AI</span>
                        </a>
                        <a href="/products/team" class="dropdown-item">
                            <span class="dropdown-item-name">Manaira Team</span>
                            <span class="dropdown-item-desc">Workforce Management</span>
                        </a>
                        <a href="/products/suite" class="dropdown-item">
                            <span class="dropdown-item-name">Manaira Suite</span>
                            <span class="dropdown-item-desc">All-in-One Business Apps</span>
                        </a>
                    </div>
                </div>
                <a href="/consulting" class="nav-link" data-text="CONSULTING">CONSULTING</a>
                <a href="/projects" class="nav-link" data-text="PROJECTS">PROJECTS</a>
                <a href="/team" class="nav-link" data-text="TEAM">TEAM</a>
                <a href="/blog" class="nav-link" data-text="BLOG">BLOG</a>
                <a href="/#contact" class="nav-link nav-cta">GET STARTED <span class="arrow">→</span></a>
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                    <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"/>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                    <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </button>
            </div>
            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
                <span></span>
                <span></span>
            </button>
        </div>
    </nav>

    <div class="mobile-menu" id="mobileMenu" role="navigation" aria-label="Mobile navigation">
        <div class="mobile-menu-content">
            <div class="mobile-dropdown">
                <span class="mobile-link-header">PRODUCTS</span>
                <a href="https://bicara.ai" target="_blank" rel="noopener" class="mobile-link-sub">BicaraAI</a>
                <a href="/products/team" class="mobile-link-sub">Manaira Team</a>
                <a href="/products/suite" class="mobile-link-sub">Manaira Suite</a>
            </div>
            <a href="/consulting" class="mobile-link">CONSULTING</a>
            <a href="/projects" class="mobile-link">PROJECTS</a>
            <a href="/team" class="mobile-link">TEAM</a>
            <a href="/blog" class="mobile-link">BLOG</a>
            <a href="/#contact" class="mobile-link accent">GET STARTED</a>
        </div>
    </div>

    <main id="main-content">
        <slot />
    </main>

    <footer class="footer" role="contentinfo">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <a href="/" class="footer-logo">
                        <img src="/icons/logo-text-light.png" alt="Manaira Labs" class="logo-img-footer logo-light">
                        <img src="/icons/logo-text-dark.png" alt="Manaira Labs" class="logo-img-footer logo-dark">
