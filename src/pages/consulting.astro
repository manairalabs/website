---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI Consulting & Development | Manaira Labs"
  description="Custom AI solutions for any scale. From strategy to production - we don't just advise, we build. Engineering-first AI consulting."
>
  <!-- Hero Section -->
  <section class="consulting-hero">
    <div class="container">
      <div class="consulting-hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span class="badge-text">AI CONSULTING</span>
        </div>

        <h1 class="consulting-hero-title">
          <span class="title-line">We Don't Just</span>
          <span class="title-line">Advise. <span class="text-gradient">We Build.</span></span>
        </h1>

        <p class="consulting-hero-subtitle">
          Engineering-first AI consulting for any scale. From startups to enterprise - every strategy
          comes with implementation. We're not done until it's in production.
        </p>

        <div class="consulting-hero-cta">
          <a href="#contact" class="btn-primary">
            <span class="btn-text">START A PROJECT</span>
            <span class="btn-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
          <a href="#services" class="btn-secondary">
            <span class="btn-text">VIEW SERVICES</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="section section-dark">
    <div class="container">
      <div class="split-content">
        <div class="split-left">
          <span class="section-label">THE PROBLEM</span>
          <h2 class="section-title">
            <span class="line">87% of AI</span>
            <span class="line">projects <span class="strikethrough">fail</span></span>
            <span class="line text-accent">never ship.</span>
          </h2>
        </div>
        <div class="split-right">
          <div class="problem-list">
            <div class="problem-item">
              <span class="problem-number">01</span>
              <div class="problem-content">
                <h4>Strategy Without Execution</h4>
                <p>Consultants deliver beautiful decks that gather dust. No one builds anything.</p>
              </div>
            </div>
            <div class="problem-item">
              <span class="problem-number">02</span>
              <div class="problem-content">
                <h4>Pilot Purgatory</h4>
                <p>Proof of concepts that never graduate. Demos that never become products.</p>
              </div>
            </div>
            <div class="problem-item">
              <span class="problem-number">03</span>
              <div class="problem-content">
                <h4>Technology Theater</h4>
                <p>Impressive tech that solves the wrong problems. AI for AI's sake.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-header center">
        <span class="section-label">SERVICES</span>
        <h2 class="section-title">What We Deliver</h2>
        <p class="section-desc">End-to-end AI solutions, from strategy to production deployment.</p>
      </div>

      <div class="services-grid">
        <div class="service-card">
          <div class="service-header">
            <span class="service-number">01</span>
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25"/>
              </svg>
            </div>
          </div>
          <h3>AI Strategy & Roadmap</h3>
          <p>Comprehensive assessment of your business processes and AI opportunities. We identify high-impact use cases, model ROI, and create actionable implementation plans.</p>
          <ul class="service-list">
            <li>Readiness Assessment</li>
            <li>Use Case Discovery</li>
            <li>ROI Modeling</li>
            <li>Technology Roadmap</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-header">
            <span class="service-number">02</span>
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z"/>
              </svg>
            </div>
          </div>
          <h3>Custom AI Development</h3>
          <p>Bespoke AI solutions built for your specific needs. From LLM applications to computer vision systems - we build production-ready AI that integrates with your existing infrastructure.</p>
          <ul class="service-list">
            <li>LLM Applications & Agents</li>
            <li>Natural Language Processing</li>
            <li>Computer Vision</li>
            <li>Predictive Analytics</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-header">
            <span class="service-number">03</span>
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/>
              </svg>
            </div>
          </div>
          <h3>System Integration</h3>
          <p>Seamlessly integrate AI capabilities into your existing systems. We handle the complex work of connecting AI to your ERP, CRM, and data infrastructure.</p>
          <ul class="service-list">
            <li>System Integration</li>
            <li>API Development</li>
            <li>Data Pipelines</li>
            <li>Cloud Infrastructure</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-header">
            <span class="service-number">04</span>
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/>
              </svg>
            </div>
          </div>
          <h3>AI Agent Development</h3>
          <p>Build autonomous AI agents that handle complex workflows. From customer service to operations - agents that work 24/7 and get better over time.</p>
          <ul class="service-list">
            <li>Multi-agent Systems</li>
            <li>Tool & API Integration</li>
            <li>Workflow Automation</li>
            <li>Human-in-the-loop</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-header">
            <span class="service-number">05</span>
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z"/>
              </svg>
            </div>
          </div>
          <h3>MLOps & Platform</h3>
          <p>Build the infrastructure to scale AI across your organization. Model management, deployment pipelines, monitoring - everything you need for enterprise AI.</p>
          <ul class="service-list">
            <li>MLOps Infrastructure</li>
            <li>Model Management</li>
            <li>Deployment Pipelines</li>
            <li>Monitoring & Scaling</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-header">
            <span class="service-number">06</span>
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
              </svg>
            </div>
          </div>
          <h3>AI Security & Governance</h3>
          <p>Implement responsible AI practices. Security assessments, compliance frameworks, and governance structures for safe AI deployment.</p>
          <ul class="service-list">
            <li>Risk Assessment</li>
            <li>Compliance Frameworks</li>
            <li>Ethical AI Guidelines</li>
            <li>Data Privacy</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-header center">
        <span class="section-label">PROCESS</span>
        <h2 class="section-title">How We Work</h2>
        <p class="section-desc">From first call to production in weeks, not years.</p>
      </div>

      <div class="process-timeline">
        <div class="timeline-line">
          <div class="timeline-progress" id="timelineProgress"></div>
        </div>

        <div class="process-steps">
          <div class="process-step active" data-step="1">
            <div class="step-marker">
              <span class="step-number">01</span>
            </div>
            <div class="step-content">
              <span class="step-duration">Week 1</span>
              <h3>DISCOVER</h3>
              <p>Deep dive into your business. Understand the pain. Define success metrics.</p>
            </div>
          </div>

          <div class="process-step" data-step="2">
            <div class="step-marker">
              <span class="step-number">02</span>
            </div>
            <div class="step-content">
              <span class="step-duration">Week 2-3</span>
              <h3>DESIGN</h3>
              <p>Architect the solution. Technical specs, not PowerPoints.</p>
            </div>
          </div>

          <div class="process-step" data-step="3">
            <div class="step-marker">
              <span class="step-number">03</span>
            </div>
            <div class="step-content">
              <span class="step-duration">Week 3-6</span>
              <h3>BUILD</h3>
              <p>Rapid iteration. Weekly demos. You see progress in real-time.</p>
            </div>
          </div>

          <div class="process-step" data-step="4">
            <div class="step-marker">
              <span class="step-number">04</span>
            </div>
            <div class="step-content">
              <span class="step-duration">Week 6-8</span>
              <h3>DEPLOY</h3>
              <p>Production-ready. Integrated. Your team trained.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section section-cta" id="contact">
    <div class="cta-bg">
      <div class="cta-grid"></div>
    </div>
    <div class="container">
      <div class="cta-content">
        <span class="section-label">START A PROJECT</span>
        <h2 class="cta-title">
          <span class="line">Let's build something</span>
          <span class="line">that works.</span>
        </h2>
        <p class="cta-desc">
          Tell us your challenge - we'll tell you how we'd solve it.
        </p>

        <form class="cta-form" id="contactForm" action="https://formspree.io/f/mqardgdj" method="POST">
          <input type="hidden" name="inquiry_type" value="AI Consulting">
          <div class="form-row">
            <div class="form-field">
              <input type="text" name="name" placeholder="Your Name" required>
              <div class="field-line"></div>
            </div>
            <div class="form-field">
              <input type="email" name="email" placeholder="Work Email" required>
              <div class="field-line"></div>
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <input type="text" name="company" placeholder="Company" required>
              <div class="field-line"></div>
            </div>
            <div class="form-field">
              <select name="service" required>
                <option value="" disabled selected>What do you need?</option>
                <option value="strategy">AI Strategy & Roadmap</option>
                <option value="development">Custom AI Development</option>
                <option value="integration">System Integration</option>
                <option value="agents">AI Agent Development</option>
                <option value="mlops">MLOps & Platform</option>
                <option value="multiple">Multiple Services</option>
              </select>
              <div class="field-line"></div>
            </div>
          </div>
          <div class="form-row full">
            <div class="form-field">
              <textarea name="message" placeholder="Tell us about your challenge and what you're trying to achieve..." rows="4" required></textarea>
              <div class="field-line"></div>
            </div>
          </div>
          <button type="submit" class="btn-submit">
            <span class="btn-text">START CONVERSATION</span>
            <span class="btn-loading">
              <svg class="spinner" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" stroke-dasharray="60" stroke-dashoffset="60"/>
              </svg>
            </span>
            <span class="btn-success">SENT ✓</span>
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Consulting Hero */
  .consulting-hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding: calc(var(--nav-height) + var(--space-2xl)) var(--space-lg) var(--space-2xl);
    background: var(--gradient-dark);
  }

  .consulting-hero-content {
    max-width: 800px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    background: rgba(0, 240, 255, 0.1);
    border: 1px solid rgba(0, 240, 255, 0.3);
    padding: var(--space-xs) var(--space-sm);
    border-radius: 100px;
    margin-bottom: var(--space-lg);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .badge-text {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--primary);
  }

  .consulting-hero-title {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-lg);
  }

  .title-line {
    display: block;
  }

  .text-gradient {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .consulting-hero-subtitle {
    font-size: 1.25rem;
    color: var(--gray-400);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .consulting-hero-cta {
    display: flex;
    gap: var(--space-md);
  }

  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  .service-card {
    padding: var(--space-xl);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    transition: all var(--duration-slow) var(--ease-out-expo);
  }

  .service-card:hover {
    background: var(--card-hover-bg);
    border-color: var(--primary);
    transform: translateY(-8px);
  }

  .service-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-lg);
  }

  .service-number {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--gray-500);
  }

  .service-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 240, 255, 0.1);
    border-radius: 8px;
    color: var(--primary);
  }

  .service-icon svg {
    width: 24px;
    height: 24px;
  }

  .service-card h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .service-card > p {
    color: var(--gray-400);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .service-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .service-list li {
    font-size: 0.8125rem;
    padding: var(--space-xs) var(--space-sm);
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    color: var(--gray-300);
  }
</style>
