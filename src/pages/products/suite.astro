---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Manaira Suite | All Your Business Apps in One Place | Manaira Labs"
  description="All the apps you need to run your business - sales, inventory, HR, accounting, and more. Plus AI employees that work for you 24/7."
>
  <!-- Hero Section -->
  <section class="product-hero">
    <div class="container">
      <div class="product-hero-content">
        <div class="product-hero-badge coming-soon">
          <span class="badge-dot"></span>
          <span class="badge-text">COMING SOON</span>
        </div>

        <h1 class="product-hero-title">
          <span class="title-line">Your Entire Business,</span>
          <span class="title-line text-gradient">Powered by AI</span>
        </h1>

        <p class="product-hero-subtitle">
          All the apps you need to run your business - sales, inventory, staff, accounting - in one place.
          Plus AI employees that work for you 24/7.
        </p>

        <div class="product-hero-cta">
          <a href="#waitlist" class="btn-primary">
            <span class="btn-text">JOIN WAITLIST</span>
            <span class="btn-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        </div>

        <div class="product-hero-stats">
          <div class="stat">
            <span class="stat-number">23</span>
            <span class="stat-label">Business modules</span>
          </div>
          <div class="stat">
            <span class="stat-number">6</span>
            <span class="stat-label">AI agents</span>
          </div>
          <div class="stat">
            <span class="stat-number">0</span>
            <span class="stat-label">Consultants needed</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is it Section -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-header center">
        <span class="section-label">WHAT IS IT</span>
        <h2 class="section-title">All Your Business Apps, One Place</h2>
        <p class="section-desc">
          Everything you need to run your business - designed for simplicity from day one.
          No expensive consultants, no months of setup. Just sign up and start.
        </p>
      </div>

      <div class="comparison-grid">
        <div class="comparison-card old">
          <h3>Traditional Software</h3>
          <ul>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Rp 50 juta+ setup cost</li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> 6-12 months to go live</li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Need consultants to configure</li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Complex training required</li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Manual data entry everywhere</li>
          </ul>
        </div>
        <div class="comparison-card new">
          <h3>Manaira Suite</h3>
          <ul>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Affordable monthly subscription</li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Go live in days</li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Self-service setup</li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Intuitive interface</li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> AI agents do the work</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Modules Section -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <span class="section-label">23 MODULES</span>
        <h2 class="section-title">Everything You Need to Run Your Business</h2>
      </div>

      <div class="modules-grid">
        <div class="module-category">
          <h3>Data Management</h3>
          <div class="module-list">
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="9" cy="7" r="4" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="#3DADB9"/><path d="M23 21v-2a4 4 0 0 0-3-3.87" stroke="#3DADB9" opacity="0.6"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke="#3DADB9" opacity="0.6"/></svg>
              <span class="module-name">Contacts</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="#3DADB9"/></svg>
              <span class="module-name">Knowledge Base</span>
            </div>
          </div>
        </div>

        <div class="module-category">
          <h3>Sales & Commerce</h3>
          <div class="module-list">
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="10" stroke="#3DADB9"/><circle cx="12" cy="12" r="6" stroke="#3DADB9" opacity="0.6"/><circle cx="12" cy="12" r="2" fill="#FF951E" stroke="#FF951E"/></svg>
              <span class="module-name">CRM</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23" stroke="#3DADB9"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke="#3DADB9"/><circle cx="12" cy="5" r="2" fill="#FF951E"/><circle cx="12" cy="19" r="2" fill="#FF951E"/></svg>
              <span class="module-name">Sales</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><line x1="2" y1="10" x2="22" y2="10" stroke="#3DADB9"/></svg>
              <span class="module-name">POS</span>
            </div>
          </div>
        </div>

        <div class="module-category">
          <h3>Operations</h3>
          <div class="module-list">
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><polyline points="3.27 6.96 12 12.01 20.73 6.96" stroke="#3DADB9"/><line x1="12" y1="22.08" x2="12" y2="12" stroke="#3DADB9"/></svg>
              <span class="module-name">Inventory</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><line x1="3" y1="6" x2="21" y2="6" stroke="#3DADB9"/><path d="M16 10a4 4 0 0 1-8 0" stroke="#3DADB9"/></svg>
              <span class="module-name">Purchase</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M5 20V10l7-7 7 7v10" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><path d="M2 20h20" stroke="#3DADB9"/><path d="M9 20v-6h6v6" stroke="#3DADB9"/></svg>
              <span class="module-name">Production</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="1" y="3" width="15" height="13" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8" stroke="#3DADB9"/><circle cx="5.5" cy="18.5" r="2.5" fill="#FF951E" stroke="#3DADB9"/><circle cx="18.5" cy="18.5" r="2.5" fill="#FF951E" stroke="#3DADB9"/></svg>
              <span class="module-name">Delivery</span>
            </div>
          </div>
        </div>

        <div class="module-category">
          <h3>Finance</h3>
          <div class="module-list">
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><polyline points="14 2 14 8 20 8" stroke="#3DADB9"/><line x1="16" y1="13" x2="8" y2="13" stroke="#3DADB9"/><line x1="16" y1="17" x2="8" y2="17" stroke="#3DADB9"/></svg>
              <span class="module-name">Invoicing</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><line x1="8" y1="21" x2="16" y2="21" stroke="#3DADB9"/><line x1="12" y1="17" x2="12" y2="21" stroke="#3DADB9"/></svg>
              <span class="module-name">Accounting</span>
            </div>
          </div>
        </div>

        <div class="module-category">
          <h3>Human Resources</h3>
          <div class="module-list">
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="7" r="4" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#3DADB9"/></svg>
              <span class="module-name">Employees</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><line x1="16" y1="2" x2="16" y2="6" stroke="#3DADB9"/><line x1="8" y1="2" x2="8" y2="6" stroke="#3DADB9"/><line x1="3" y1="10" x2="21" y2="10" stroke="#3DADB9"/></svg>
              <span class="module-name">Shifts</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="10" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><polyline points="12 6 12 12 16 14" stroke="#3DADB9"/></svg>
              <span class="module-name">Attendance</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><path d="M12 8v8" stroke="#3DADB9"/><path d="M8 12h8" stroke="#3DADB9"/></svg>
              <span class="module-name">Payroll</span>
            </div>
          </div>
        </div>

        <div class="module-category">
          <h3>Services</h3>
          <div class="module-list">
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/></svg>
              <span class="module-name">Projects</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/></svg>
              <span class="module-name">Helpdesk</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><line x1="16" y1="2" x2="16" y2="6" stroke="#3DADB9"/><line x1="8" y1="2" x2="8" y2="6" stroke="#3DADB9"/><line x1="3" y1="10" x2="21" y2="10" stroke="#3DADB9"/><circle cx="8" cy="14" r="1" fill="#FF951E"/><circle cx="12" cy="14" r="1" fill="#FF951E"/><circle cx="16" cy="14" r="1" fill="#FF951E"/></svg>
              <span class="module-name">Appointments</span>
            </div>
          </div>
        </div>

        <div class="module-category">
          <h3>Communication</h3>
          <div class="module-list">
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><polyline points="22,6 12,13 2,6" stroke="#3DADB9"/></svg>
              <span class="module-name">Inbox</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14" stroke="#3DADB9"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07" stroke="#3DADB9"/></svg>
              <span class="module-name">Broadcast</span>
            </div>
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="10" fill="#FF951E" fill-opacity="0.2" stroke="#3DADB9"/><polyline points="22 4 12 14.01 9 11.01" stroke="#FF951E" stroke-width="2.5"/></svg>
              <span class="module-name">Tasks</span>
            </div>
          </div>
        </div>

        <div class="module-category">
          <h3>Analytics</h3>
          <div class="module-list">
            <div class="module-item">
              <svg class="module-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10" stroke="#3DADB9"/><line x1="12" y1="20" x2="12" y2="4" stroke="#FF951E" stroke-width="3"/><line x1="6" y1="20" x2="6" y2="14" stroke="#3DADB9"/></svg>
              <span class="module-name">Insight</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AI Agents Section -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-header center">
        <span class="section-label">AI AGENTS</span>
        <h2 class="section-title">6 Digital Employees That Never Sleep</h2>
        <p class="section-desc">AI agents that handle repetitive tasks across your business. They work 24/7, follow your rules, and get better over time.</p>
      </div>

      <div class="agents-grid">
        <div class="agent-card">
          <div class="agent-avatar cs">CS</div>
          <h3>CS Agent</h3>
          <p>Handles customer inquiries across WhatsApp, email, and chat. Answers FAQs, routes complex issues to humans.</p>
        </div>

        <div class="agent-card">
          <div class="agent-avatar sales">Sales</div>
          <h3>Sales Agent</h3>
          <p>Qualifies leads, follows up on opportunities, processes orders. Sends quotes and reminders automatically.</p>
        </div>

        <div class="agent-card">
          <div class="agent-avatar procurement">Proc</div>
          <h3>Procurement Agent</h3>
          <p>Monitors stock levels, creates purchase orders, negotiates with vendors. Never runs out of inventory.</p>
        </div>

        <div class="agent-card">
          <div class="agent-avatar supervisor">Supv</div>
          <h3>Supervisor Agent</h3>
          <p>Monitors team performance, sends alerts on anomalies, escalates issues. Your always-on operations manager.</p>
        </div>

        <div class="agent-card">
          <div class="agent-avatar production">Prod</div>
          <h3>Production Agent</h3>
          <p>Optimizes production schedules, tracks progress, manages quality control. Built for bakeries and manufacturers.</p>
        </div>

        <div class="agent-card">
          <div class="agent-avatar collections">Coll</div>
          <h3>Collections Agent</h3>
          <p>Sends payment reminders, follows up on overdue invoices, tracks receivables. Gets you paid faster.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Target Market Section -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <span class="section-label">BUILT FOR</span>
        <h2 class="section-title">Any Business</h2>
      </div>

      <div class="markets-row">
        <div class="market-chip">
          <svg class="market-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/></svg>
          <span>E-commerce</span>
        </div>
        <div class="market-chip">
          <svg class="market-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
          <span>Restaurants & Cafes</span>
        </div>
        <div class="market-chip">
          <svg class="market-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span>Retail Stores</span>
        </div>
        <div class="market-chip">
          <svg class="market-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/></svg>
          <span>Service Companies</span>
        </div>
        <div class="market-chip">
          <svg class="market-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
          <span>Healthcare</span>
        </div>
        <div class="market-chip">
          <svg class="market-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/></svg>
          <span>Education</span>
        </div>
        <div class="market-chip">
          <svg class="market-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
