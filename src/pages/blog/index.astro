---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = ['All', 'Insights', 'SMB Insights', 'Product Updates', 'Case Study', 'Tutorial', 'News'];
const languages = [
  { value: 'all', label: 'All Languages' },
  { value: 'en', label: 'English' },
  { value: 'id', label: 'Bahasa Indonesia' },
];
---

<BaseLayout
  title="Blog | Manaira Labs"
  description="AI insights for business - from enterprise strategy to SMB solutions. Learn how AI can transform your operations."
>
  <link rel="stylesheet" href="/styles/blog.css" slot="head" />

  <!-- Blog Hero -->
  <section class="blog-hero">
    <div class="container">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span class="badge-text">BLOG</span>
      </div>
      <h1 class="blog-title">
        <span class="title-line">AI for <span class="text-gradient">Business</span></span>
      </h1>
      <p class="blog-subtitle">
        Practical AI insights for SMBs and enterprises. Product updates, case studies, and strategies that work.
      </p>
    </div>
  </section>

  <section class="section blog-list-section">
    <div class="container">
      <!-- Filters Row -->
      <div class="blog-filters-row">
        <!-- Category Filter -->
        <div class="filter-group">
          {categories.map((category) => (
            <button
              class={`filter-btn category-btn ${category === 'All' ? 'active' : ''}`}
              data-category={category}
            >
              {category}
            </button>
          ))}
        </div>

        <!-- Language Filter -->
        <div class="filter-group lang-group">
          {languages.map((lang) => (
            <button
              class={`filter-btn lang-btn ${lang.value === 'all' ? 'active' : ''}`}
              data-lang={lang.value}
            >
              {lang.value === 'all' ? 'All' : lang.value.toUpperCase()}
            </button>
          ))}
        </div>
      </div>

      {posts.length === 0 ? (
        <p class="no-posts">No posts yet. Check back soon!</p>
      ) : (
        <div class="blog-grid" id="blogGrid">
          {posts.map((post) => (
            <article class="blog-card" data-category={post.data.category} data-lang={post.data.lang}>
              {post.data.heroImage && (
                <a href={`/blog/${post.id}`} class="blog-card-image">
                  <img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
                </a>
              )}
              <div class="blog-card-content">
                <div class="blog-card-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    })}
                  </time>
                  <span class="blog-card-category">{post.data.category}</span>
                  <span class={`blog-card-lang ${post.data.lang}`}>
                    {post.data.lang === 'id' ? 'ID' : 'EN'}
                  </span>
                </div>
                <h2 class="blog-card-title">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="blog-card-excerpt">{post.data.description}</p>
                <a href={`/blog/${post.id}`} class="blog-card-link">
                  Read more <span>→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const langBtns = document.querySelectorAll('.lang-btn');
      const categoryBtns = document.querySelectorAll('.category-btn');
      const blogCards = document.querySelectorAll('.blog-card');

      let currentLang = 'all';
      let currentCategory = 'All';

      function filterCards() {
        blogCards.forEach(card => {
          const matchesLang = currentLang === 'all' || card.dataset.lang === currentLang;
          const matchesCategory = currentCategory === 'All' || card.dataset.category === currentCategory;

          if (matchesLang && matchesCategory) {
            card.style.display = '';
            card.style.animation = 'fadeIn 0.3s ease';
          } else {
            card.style.display = 'none';
          }
        });
      }

      langBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          langBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentLang = btn.dataset.lang;
          filterCards();
        });
      });

      categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          categoryBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentCategory = btn.dataset.category;
          filterCards();
        });
      });
    });
  </script>
</BaseLayout>

